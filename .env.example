# Backend Environment Variables
NODE_ENV=production
PORT=10000

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/facial_recognition

# Security
JWT_SECRET=your_super_secure_jwt_secret_here
ENCRYPTION_KEY=your_64_character_hex_encryption_key

# External Services
PYTHON_SERVICE_URL=https://your-python-service-url.run.app
CLIENT_URL=https://your-frontend.vercel.app